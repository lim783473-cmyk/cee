{
  "manifest_version": 3,
  "name": "cee",
  "version": "0.7.0",
  "description": "Opt-in smart form filling: press Alt+V in any field to fill it from your clipboard. Plain Ctrl+V stays native.",
  "update_url": "https://cee.songm.dpdns.org/updates.xml",
  "permissions": [
    "storage",
    "clipboardRead",
    "webNavigation"
  ],
  "host_permissions": [
    "https://cee.songm.dpdns.org/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Show cee",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+J",
        "mac": "Command+J"
      }
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "adapters.js",
        "shared-ui.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/copy.png",
        "assets/inter-var.woff2",
        "assets/copy.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
